<Window x:Class="AppUsageTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AppUsageTracker.ViewModels"
        xmlns:conv="clr-namespace:AppUsageTracker.Converters"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="App Usage Tracker" Height="500" Width="960"
        WindowStartupLocation="CenterScreen"
        Icon="/Resources/app.ico"
        StateChanged="MainWindow_StateChanged"
        Closing="MainWindow_Closing"
        Background="{StaticResource NotebookBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
        <conv:BoolToTrackingBrushConverter x:Key="TrackingStateBrushConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Lives for the lifetime of the window; minimizing hides the
             window instead of closing it, and this icon is how the user
             gets back to it (or exits for real). Placed directly in the
             visual tree (rather than as a resource) so its Loaded event
             actually fires and the native tray icon gets created. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                         Grid.Row="0"
                         IconSource="/Resources/app.ico"
                         ToolTipText="App Usage Tracker"
                         TrayMouseDoubleClick="TrayIcon_DoubleClick"
                         TrayLeftMouseUp="TrayIcon_LeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="TrayShow_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial Kind="WindowRestore" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Exit" Click="TrayExit_Click">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial Kind="ExitToApp" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Top toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12"
                    Background="Transparent"
                    MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <Button Command="{Binding StartTrackingCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                    Padding="14,7" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Play" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Start Tracking" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding StopTrackingCommand}"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Padding="14,7" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Stop" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Stop Tracking" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <iconPacks:PackIconMaterial Kind="CircleMedium"
                                         Width="14" Height="14"
                                         VerticalAlignment="Center"
                                         Margin="0,0,4,0"
                                         Foreground="{Binding IsTracking, Converter={StaticResource TrackingStateBrushConverter}}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                       FontWeight="SemiBold" />

            <Button Click="OpenSettings_Click"
                    Style="{StaticResource MahApps.Styles.Button.Square}"
                    Padding="8,6" Margin="16,0,0,0"
                    ToolTip="Settings">
                <iconPacks:PackIconMaterial Kind="Cog" Width="16" Height="16" />
            </Button>
        </StackPanel>

        <!-- Two panes: live session log + aggregated totals -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Session log (today)" Grid.Column="0"
                      Style="{DynamicResource MahApps.Styles.GroupBox}"
                      Background="Transparent">
                <DataGrid ItemsSource="{Binding SessionRecords}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          Style="{DynamicResource MahApps.Styles.DataGrid}"
                          CellStyle="{DynamicResource MahApps.Styles.DataGridCell}"
                          ColumnHeaderStyle="{DynamicResource MahApps.Styles.DataGridColumnHeader}"
                          RowStyle="{DynamicResource MahApps.Styles.DataGridRow}"
                          Background="#CCFFFFFF"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#14000000">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconSource}" Width="16" Height="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Application" Binding="{Binding ProcessName}" Width="140" />
                        <DataGridTextColumn Header="Window Title" Binding="{Binding WindowTitle}" Width="*" />
                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat='HH:mm:ss'}" Width="80" />
                        <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat='HH:mm:ss'}" Width="80" />
                        <DataGridTextColumn Header="Duration"
                                             Binding="{Binding Duration, Converter={StaticResource TimeSpanConverter}}"
                                             Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Total time by application" Grid.Column="2"
                      Style="{DynamicResource MahApps.Styles.GroupBox}"
                      Background="Transparent">
                <DataGrid ItemsSource="{Binding Summaries}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          Style="{DynamicResource MahApps.Styles.DataGrid}"
                          CellStyle="{DynamicResource MahApps.Styles.DataGridCell}"
                          ColumnHeaderStyle="{DynamicResource MahApps.Styles.DataGridColumnHeader}"
                          RowStyle="{DynamicResource MahApps.Styles.DataGridRow}"
                          Background="#CCFFFFFF"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#14000000">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="28" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconSource}" Width="16" Height="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Application" Binding="{Binding ProcessName}" Width="*" />
                        <DataGridTextColumn Header="Total"
                                             Binding="{Binding TotalDuration, Converter={StaticResource TimeSpanConverter}}"
                                             Width="70" />
                        <DataGridTextColumn Header="#" Binding="{Binding SessionCount}" Width="30" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
