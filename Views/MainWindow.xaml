<Window
    x:Class="AppUsageTracker.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AppUsageTracker.Converters"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:vm="clr-namespace:AppUsageTracker.ViewModels"
    Title="App Usage Tracker"
    Width="960"
    Height="500"
    Closing="MainWindow_Closing"
    Icon="/Resources/app.ico"
    StateChanged="MainWindow_StateChanged"
    WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanConverter" />
        <conv:BoolToTrackingBrushConverter x:Key="TrackingStateBrushConverter" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Lives for the lifetime of the window; minimizing hides the
            window instead of closing it, and this icon is how the user
            gets back to it (or exits for real). Placed directly in the
            visual tree (rather than as a resource) so its Loaded event
            actually fires and the native tray icon gets created.
        -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            Grid.Row="0"
            IconSource="/Resources/app.ico"
            ToolTipText="App Usage Tracker"
            TrayLeftMouseUp="TrayIcon_LeftClick"
            TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Click="TrayShow_Click" Header="Show">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial
                                Width="14"
                                Height="14"
                                Kind="WindowRestore" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Click="TrayExit_Click" Header="Exit">
                        <MenuItem.Icon>
                            <iconPacks:PackIconMaterial
                                Width="14"
                                Height="14"
                                Kind="ExitToApp" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!--  Top toolbar  -->
        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            MouseLeftButtonDown="Toolbar_MouseLeftButtonDown"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Padding="14,7"
                Command="{Binding StartTrackingCommand}"
                Style="{StaticResource MahApps.Styles.Button}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Kind="Play" />
                    <TextBlock VerticalAlignment="Center" Text="Start Tracking" />
                </StackPanel>
            </Button>

            <Button
                Margin="0,0,16,0"
                Padding="14,7"
                Command="{Binding StopTrackingCommand}"
                Style="{StaticResource MahApps.Styles.Button}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Kind="Stop" />
                    <TextBlock VerticalAlignment="Center" Text="Stop Tracking" />
                </StackPanel>
            </Button>

            <iconPacks:PackIconMaterial
                Width="14"
                Height="14"
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                Foreground="{Binding IsTracking, Converter={StaticResource TrackingStateBrushConverter}}"
                Kind="CircleMedium" />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding StatusText}" />

            <Button
                Margin="16,0,0,0"
                Padding="8,6"
                Click="OpenSettings_Click"
                Style="{StaticResource MahApps.Styles.Button}"
                ToolTip="Settings">
                <iconPacks:PackIconMaterial
                    Width="16"
                    Height="16"
                    Kind="Cog" />
            </Button>
        </StackPanel>

        <!--  Two panes: live session log + aggregated totals  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <GroupBox
                Grid.Column="0"
                Header="Session log (today)"
                Style="{DynamicResource MahApps.Styles.GroupBox}">
                <DataGrid
                    AlternatingRowBackground="#14000000"
                    AutoGenerateColumns="False"
                    Background="#B3FFFFFF"
                    CanUserAddRows="False"
                    ColumnHeaderStyle="{DynamicResource MahApps.Styles.DataGridColumnHeader}"
                    GridLinesVisibility="Horizontal"
                    IsReadOnly="True"
                    ItemsSource="{Binding SessionRecords}"
                    Style="{DynamicResource MahApps.Styles.DataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="28"
                            CanUserResize="False"
                            Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding IconSource}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding ProcessName}"
                            Header="Application" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding WindowTitle}"
                            Header="Window Title" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding StartTime, StringFormat='HH:mm:ss'}"
                            Header="Start" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding EndTime, StringFormat='HH:mm:ss'}"
                            Header="End" />
                        <DataGridTextColumn
                            Width="80"
                            Binding="{Binding Duration, Converter={StaticResource TimeSpanConverter}}"
                            Header="Duration" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox
                Grid.Column="2"
                Header="Total time by application"
                Style="{DynamicResource MahApps.Styles.GroupBox}">
                <DataGrid
                    AlternatingRowBackground="#14000000"
                    AutoGenerateColumns="False"
                    Background="#B3FFFFFF"
                    CanUserAddRows="False"
                    ColumnHeaderStyle="{DynamicResource MahApps.Styles.DataGridColumnHeader}"
                    GridLinesVisibility="Horizontal"
                    IsReadOnly="True"
                    ItemsSource="{Binding Summaries}"
                    Style="{DynamicResource MahApps.Styles.DataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="28"
                            CanUserResize="False"
                            Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Source="{Binding IconSource}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding ProcessName}"
                            Header="Application" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding TotalDuration, Converter={StaticResource TimeSpanConverter}}"
                            Header="Total" />
                        <DataGridTextColumn
                            Width="30"
                            Binding="{Binding SessionCount}"
                            Header="#" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
